# Copy this to .env and fill in your real values.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/fifth_avenue_internal?retryWrites=true&w=majority

# RapidAPI key for Instagram Scraper Stable API (used by Add Creator auto-fetch)
RAPIDAPI_KEY=your_rapidapi_key_here

PORT=4000

# HikerAPI (Instagram post metrics + the client portal's reel cache)
HIKERAPI_TOKEN=your_hikerapi_token_here

# YouTube Data API v3 (post metrics for YouTube links)
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Nightly jobs ────────────────────────────────────────────────────────────
# Set to 1 on every machine that is not the single production instance. The
# scheduler runs in-process (scheduler.js), so a developer's server left running
# overnight executes the same paid jobs against the same database.
DISABLE_SCHEDULER=1

# Whether a brand's page load may fetch a post the cache has never seen.
# 0 makes GET /api/portal/reels strictly database-only; posts are fetched once
# at campaign-save time instead. See warmReels() in portalReels.js.
PORTAL_REELS_FILL_ON_READ=0
